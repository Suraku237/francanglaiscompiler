# Copy only if backend/.env does not exist. Never overwrite existing secrets.
# Keep real credentials out of this template, the frontend and version control.
# Environment variables override backend/.env, which overrides the project root .env.
# Restart the Python server after changing settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# One-origin local test defaults. Production MUST use HTTPS and SMTP.
MBOA_ENVIRONMENT=development
MBOA_PUBLIC_URL=http://127.0.0.1:8000
MBOA_MAIL_MODE=file
# Default private storage is the repository's .mboa directory.
# For hosting set a persistent absolute path outside the public web root:
# MBOA_DATA_DIR=C:\MboaData
# MBOA_DATA_DIR=/var/lib/mboa

# SMTP uses STARTTLS. Supply the sender and provider-specific authentication.
MBOA_SMTP_HOST=
MBOA_SMTP_PORT=587
MBOA_SMTP_USERNAME=
MBOA_SMTP_PASSWORD=
MBOA_MAIL_FROM=

# Optional Google Web application OAuth client: set BOTH values or neither.
# Register <MBOA_PUBLIC_URL>/api/auth/google/callback as the redirect URI.
MBOA_GOOGLE_CLIENT_ID=
MBOA_GOOGLE_CLIENT_SECRET=

# Actual outbound AI attempts per UTC quota day, including retries.
MBOA_AI_DAILY_USER_LIMIT=100
MBOA_AI_DAILY_GLOBAL_LIMIT=2000

# Hosting: trust only your reverse proxy's address(es), never arbitrary clients.
# FORWARDED_ALLOW_IPS=127.0.0.1
