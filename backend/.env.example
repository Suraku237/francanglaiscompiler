# Copy this template to backend/.env, then paste your Gemini API key there.
# Keep real keys out of this example file and out of version control.
# Environment variables override backend/.env, which overrides the project root .env.
# Restart the Python server after changing settings.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=45
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
