@startuml
!include theme.iuml
allowmixing
title React implementation — one authored class, functions and hooks
hide empty members
class ApiError {
  status: number {readOnly}
  constructor(message: string, status: number)
}
class "JavaScript Error" as Error <<external>>
rectangle "api.ts <<function module>>\napi<T>(), configureSession(), nativeApiUrl()\nerrorDetail(), isCancelled(), messageOf()" as API
rectangle "PublicSession.tsx <<function component>>\nbootstrap public capabilities + CSRF\nrender App only after validation" as Session
rectangle "App.tsx <<function components>>\nApp(), PrivacyDialog()\nfive-page navigation and exact text handoff" as App
rectangle "FrancAnalyzer.tsx <<function component>>\nrecord public test / saved-test selection\npending request UUID / stale grammar state" as Analyzer
rectangle "Analysis.tsx / TestStatistics.tsx\nCourseworkResults.tsx / VocabularyVerdict.tsx\n<<function-component modules>>" as Analysis
rectangle "Collection.tsx / Dictionary.tsx / Examples.tsx\n<<function-component modules>>\nread-only browsing and handoff" as Pages
rectangle "useRequest.ts <<hook>>\nrun / cancel / pending / error" as Request
rectangle "voice.ts <<hook module>>\nuseReadAloud(): selection / speak / stop\nselects an existing-recording lookup" as Voice
rectangle "RecordedReadings.tsx <<functions>>\nRecordedReadings(), ReadingDialog()" as Readings
rectangle "AudioRecorder.tsx <<function>>\nAudioPlayer(): native audio + download" as Player
rectangle "audioFocus.ts <<function module>>\nclaimAudioFocus(), hasAudioFocus()" as Focus
rectangle "Retained, not rendered publicly\nAudioRecorder() / useAudioRecorder()\n<<function / hook>>" as Recorder #FFF6E8
ApiError --|> Error
API ..> ApiError : throws
Session ..> API
Session ..> Request
Session ..> App : renders after bootstrap
App ..> Analyzer
App ..> Pages
App ..> Voice
App ..> Readings
Analyzer ..> Analysis
Analyzer ..> Request
Analyzer ..> API
Analyzer ..> ApiError : 409 marks grammar stale
Pages ..> API
Pages ..> Player : Collection attachments
Request ..> API : cancellation and safe message helpers
Readings ..> API : POST reading lookup
Readings ..> Player
Player ..> Focus : one active audio source
Recorder ..> Focus : retained recorder implementation
note bottom of Voice
  The historical name speak() now opens a recorded-reading
  selection. It does not call speechSynthesis or record a mic.
  Hooks, components, TypeScript interfaces and callbacks
  are not invented runtime classes.
end note
legend bottom
  AuthGate, account controls, project selectors and account counter are absent from the current frontend.
  Only frontend.src.api.ApiError is an authored production TypeScript class.
  Existing AudioRecorder/useAudioRecorder source does not imply a public capture/upload capability.
endlegend
@enduml
