@startuml
!include theme.iuml
title Authenticated compiler lab: grammar analysis and category-token parsing
hide footbox
autonumber
actor Learner
participant "Compiler lab\n<<React functions>>" as Web
participant "coursework_api / orchestration\n<<functions>>" as API
participant "grammar / analysis\n<<modules>>" as Grammar
participant "coursework lexical helpers /\nlexer / dataset <<modules>>" as Lexer
participant "predictive\n<<module>>" as Parser
participant "coursework_store\n<<module>>" as Store
activate Learner
Learner -> Web : Analyze corpus or Parse practice input
activate Web
Web -> API : POST /api/coursework/analyze or /parse
activate API
note over API : Identity and selected-project dataset/coursework contexts are already bound.
opt Corpus analysis
  API -> Lexer : read_corpus()
  activate Lexer
  Lexer --> API : Bounded saved entries or storage/limit error
  deactivate Lexer
end
alt Initial corpus read failed
  note over API : Return safe error without starting grammar work.
else Corpus snapshot available or practice-only request
  API -> Grammar : analyze_grammar(editor grammar)
  activate Grammar
  Grammar -> Grammar : read_grammar(); transform_grammar()
  activate Grammar
  note over Grammar : Validate notation/limits; eliminate supported recursion;\nleft-factor and retain bounded transformation snapshots.
  Grammar --> Grammar : Rules/steps or GrammarError
  deactivate Grammar
  opt Valid bounded transformation
    Grammar -> Grammar : calculate_first(); calculate_follow();\nbuild_table(); left_recursive_nonterminals()
    activate Grammar
    Grammar --> Grammar : Sets, non-conflicting cells, conflicts and warnings
    deactivate Grammar
  end
  Grammar --> API : Analysis or GrammarError
  deactivate Grammar
  alt Invalid grammar or expansion limits
    note over API : GrammarError becomes HTTP 422.
  else Valid result (possibly not LL(1))
    API -> Lexer : lexical_report(snapshot) or tokens_for(practice text)
    activate Lexer
    note over Lexer : Practice uses the selected project's reviewed word map.\nRegex, annotations, lists, heuristics; preserve UNKNOWN.
    Lexer --> API : Tokens/report or storage failure
    deactivate Lexer
    opt Lexical work succeeded
      loop Every saved entry, or one practice input
        API -> Parser : parse_analysis(grammar, tokens)
        activate Parser
        alt Conflicts / unresolved recursion
          note over Parser : Reject; never choose an arbitrary conflicting rule.
        else Executable LL(1) table
          note over Parser : Bounded stack machine with pre-action trace.\nFull input and end marker must agree.
        end
        Parser --> API : accepted, error, trace, consumed
        deactivate Parser
      end
      opt Corpus analysis
        API -> Store : load_project()
        activate Store
        Store --> API : Saved profile or storage/validation error
        deactivate Store
        note over API : Combine profile, corpus and computed grammar\nfor readiness checks; no profile write.
      end
    end
  end
end
API --> Web : Structured result or safe HTTP error
deactivate API
Web --> Learner : Tables/traces; editor not implicitly saved
deactivate Web
deactivate Learner
legend bottom
  Module self-calls condense internal function boundaries.
  No provider determines parsing. Corpus/grammar fit is not linguistic authenticity.
  Corpus/media stay unchanged; a new private project starts with no statements.
  Illustrative grammar/practice and successful parsing do not establish authentic fieldwork.
endlegend
@enduml
