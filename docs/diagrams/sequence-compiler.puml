@startuml
!include theme.iuml
title Deterministic compiler — actual function calls and trace construction
hide footbox
autonumber
participant "analyzer_history / analyzer\n<<caller functions>>" as Caller
participant "parser.service\n<<functions>>" as Service
participant "parser.grammar\n<<functions>>" as Grammar
participant "parser.analysis\n<<functions>>" as Analysis
participant "lexer.tokenizer\n<<functions>>" as Lexer
participant "parser.predictive\n<<functions>>" as Parser
activate Caller
Caller -> Service : analyze_grammar(saved grammar)
activate Service
Service -> Grammar : read_grammar(grammar_text)
activate Grammar
Grammar --> Service : ordered grammar dictionary, or GrammarError
deactivate Grammar
opt valid bounded notation
  Service -> Analysis : transform_grammar(original)
  activate Analysis
  note over Analysis : Real _Transformations records before/after dictionaries.\nOrdered substitution, direct elimination and factoring are bounded.
  Analysis --> Service : transformed grammar + steps, or GrammarError
  deactivate Analysis
  opt transformation succeeds
    Service -> Analysis : calculate_first(transformed)
    activate Analysis
    Analysis --> Service : FIRST sets
    deactivate Analysis
    Service -> Analysis : calculate_follow(transformed, start, first)
    activate Analysis
    Analysis --> Service : FOLLOW sets
    deactivate Analysis
    Service -> Analysis : build_table(transformed, first, follow)
    activate Analysis
    Analysis --> Service : unambiguous table + all conflicts
    deactivate Analysis
  end
end
Service --> Caller : JSON-shaped grammar analysis, or explicit error
deactivate Service
opt grammar analysis produced a result
  note over Caller : Load Collection and build_lexicon(entries) for the current locked revision.
  Caller -> Lexer : analyze_sentence(text, learned)
  activate Lexer
  Lexer -> Lexer : tokenize(text)
  activate Lexer
  Lexer --> Lexer : raw source tokens
  deactivate Lexer
  loop each raw token
    Lexer -> Lexer : classify_token(token, learned)
    activate Lexer
    Lexer --> Lexer : category
    deactivate Lexer
  end
  note over Lexer : analyze_sentence() constructs Token(text, category) for each raw token.
  Lexer --> Caller : tokens, code-mixed spans and verb phrases
  deactivate Lexer
  note over Caller : analyze_manual() adds slang annotations and token_statistics().
  Caller -> Parser : parse_analysis(grammar, lexical token dictionaries)
  activate Parser
  note over Parser : Reject conflicts/remaining left recursion; otherwise run bounded stack machine.\nRecord stack, remaining categories and action before each action.\nUNKNOWN is an ordinary terminal, never a wildcard.
  Parser --> Caller : accepted/error, consumed and parse trace
  deactivate Parser
end
deactivate Caller
legend bottom
  This shows the saved/custom grammar path; the generic teaching starter alone has a decoded JSON cache.
  Parser bounds: 256 input tokens, 1000 characters/token, 2000 trace steps, 1024 stack symbols.
  Vocabulary approval is a separate later calculation: only UNKNOWN causes that verdict to reject.
endlegend
@enduml
