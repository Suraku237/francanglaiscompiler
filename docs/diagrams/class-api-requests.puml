@startuml
!include theme.iuml
title Deterministic analysis request contract
hide empty members
class "pydantic.BaseModel" as BaseModel <<external>> {
  model_validate(value) {inherited}
  model_dump() {inherited}
}
class RequestModel {
  model_config: extra = forbid
}
class AnalyzeRequest {
  text: StoredText [1..4000 chars]
  nonblank_text(text): str
}
RequestModel --|> BaseModel
AnalyzeRequest --|> RequestModel
note bottom of AnalyzeRequest
  Raw whitespace, accents and spelling are preserved.
  Empty/whitespace-only input is rejected.
  StoredText is a constrained string alias, not a class.
end note
legend bottom
  Production classes: backend.schemas.RequestModel and AnalyzeRequest.
  Concrete collection/coursework request subclasses are in their detail views.
  Removed translator/chat request classes are not part of the current inventory.
endlegend
@enduml
