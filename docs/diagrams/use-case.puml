@startuml
!include theme.iuml
left to right direction
title Implemented user goals and explicit optional processing
actor "Contributor / maintainer" as Contributor
actor "Learner / group reviewer" as Learner
rectangle "Francanglais platform (local trust boundary)" {
  usecase "Collect / search / edit /\nconfirm deletion" as Collect
  usecase "Stage or play desktop audio" as Audio
  usecase "Review language, glosses\nand approval status" as Review
  usecase "Preview an import" as Preview
  usecase "Cloud transcription / OCR" as CloudImport
  usecase "Translate with visible origin\nand evidence coverage" as Translate
  usecase "Approved local lookup" as Lookup
  usecase "AI translation suggestion" as AITranslate
  usecase "Explicit learning chat" as Chat
  usecase "Analyze lexer / CFG /\nFIRST-FOLLOW / parse trace" as Analyze
  usecase "Optional compiler tutoring" as Tutor
  usecase "Save coursework profile /\nupload genuine screenshots" as Project
  usecase "Export saved coursework draft" as Export
}
Contributor -- Collect
Contributor -- Audio
Contributor -- Review
Contributor -- Preview
Learner -- Translate
Learner -- Chat
Learner -- Analyze
Learner -- Tutor
Learner -- Project
Learner -- Export
Lookup ..> Translate : <<extend>>\n[use_dataset]
AITranslate ..> Translate : <<extend>>\n[no exact answer and allow_ai]
CloudImport ..> Preview : <<extend>>\n[needed and consented]
note bottom of Review
  Saved does not mean approved.
  Preview/handoff never auto-saves.
  Roles are not authentication permissions.
end note
note bottom of Export
  Draft generation is not completed fieldwork,
  final report pagination or group sign-off.
end note
@enduml
