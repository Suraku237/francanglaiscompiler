@startuml
!include theme.iuml
title Verified Collector - User Goals
left to right direction
skinparam packageStyle rectangle

actor "Contributor" as contributor
actor "Project maintainer" as maintainer

rectangle "Francanglais Dataset Collector" {
  usecase "Collect an annotated entry\n(extension point: before save)" as Collect
  usecase "Validate non-empty text" as Validate
  usecase "Attach an audio file" as Attach
  usecase "Record microphone audio" as Record
  usecase "Browse and search entries" as Browse
  usecase "Edit a selected entry" as Edit
  usecase "Delete a selected entry" as Delete
  usecase "Confirm deletion" as Confirm
  usecase "Play pending or stored audio" as Play
  usecase "View corpus statistics" as Stats
}

maintainer --|> contributor
contributor -- Collect
contributor -- Browse
contributor -- Play
contributor -- Stats
maintainer -- Edit
maintainer -- Delete
Collect .> Validate : <<include>>
Edit .> Validate : <<include>>
Delete .> Confirm : <<include>>
Attach .> Collect : <<extend>>\n[user selects a file]
Record .> Collect : <<extend>>\n[user records; capability available]

legend bottom left
  Includes point to required sub-behavior.
  Extensions point to the base use case, not the reverse.
  Maintainer inherits contributor goals; these are roles, not login permissions.
  Audio files are data, not actors. Compiler goals are future scope in the SRS.
endlegend
@enduml
