@startuml
!include theme.iuml
allowmixing
title Preserved desktop compatibility: actual classes and audio ownership
hide empty members
' @class data_collector.App.App
class App {
  recorder: Recorder | None
  pending_audio_path: str | None
  selected_browse_id: str | None
  selected_browse_audio: str | None
  _browse_entries_by_id: dict
  _staged_audio_files: set[str]
  _captured_audio
  _recording_pending_stop: bool
  save_entry()
  toggle_recording()
  attach_audio_file()
  _save_browse_edit()
  _delete_browse_entry()
  _refresh_stats()
  destroy()
}
' @class data_collector.App.Tooltip
class Tooltip {
  widget
  text: str
  tip_window
  _show(event=None)
  _hide(event=None)
}
' @class data_collector.audio_utils.Recorder
class Recorder {
  frames: list
  stream: InputStream | None
  recording: bool
  start()
  stop()
  close()
}
' @class data_collector.audio_utils.AudioError
class AudioError
' @class data_collector.dataset.EntryNotFoundError
class EntryNotFoundError
class RuntimeError <<external>>
class LookupError <<external>>
class "customtkinter.CTk" as CTk <<external>>
class "Widget" as Widget <<external>>
class "CTkToplevel" as TipWindow <<external>>
class "sounddevice.InputStream" as Stream <<external>>
rectangle "dataset.py <<module>>\nload_all(), append_entry()\nupdate_entry(), delete_entry()\ndataset_lock(), count_by()" as Dataset
rectangle "audio_utils.py <<module>>\nattach_file(), save_recording()\nplay_audio()" as Audio
App --|> CTk
App "1" *-- "0..1" Recorder : creates when audio is available
Recorder "0..1" --> "0..1" Stream : stream
Tooltip "0..*" --> "1" Widget : widget
Tooltip "0..1" --> "0..1" TipWindow : tip_window
App ..> Tooltip : creates for controls
App ..> Dataset : calls functions
App ..> Audio : calls functions
AudioError --|> RuntimeError
EntryNotFoundError --|> LookupError
Recorder ..> AudioError : raises retryable failures
Audio ..> AudioError : raises file / playback errors
Dataset ..> EntryNotFoundError : rejects stale IDs
App ..> AudioError : reports and retains retry state
App ..> EntryNotFoundError : reports no longer available
note bottom of Recorder
  One optional stream per recorder.
  Frames are sample arrays, not domain classes.
  Callback execution is asynchronous.
end note
note bottom of Tooltip
  A tooltip retains one widget and at most one
  popup. App does not store a Tooltip collection:
  bound callbacks retain these helper objects.
end note
legend bottom
  This is the optional local desktop collector, not the default authenticated web UI.
  Five production classes; library types are explicitly external.
  Per-instance target multiplicities express stored references.
  Audio filenames are not object ownership or database foreign keys.
endlegend
@enduml
