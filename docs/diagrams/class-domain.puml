@startuml
!include theme.iuml
allowmixing
title Retained desktop collector — actual GUI, helper and recorder classes
hide empty members
class App <<retained>> {
  recorder: Recorder | None
  pending_audio_path: str | None
  selected_browse_id: str | None
  selected_browse_audio: str | None
  _browse_entries_by_id: dict
  _staged_audio_files: set[str]
  _captured_audio
  _recording_pending_stop: bool
  save_entry()
  toggle_recording()
  attach_audio_file()
  _save_browse_edit()
  _delete_browse_entry()
  _refresh_stats()
  destroy()
}
class Tooltip <<retained>> {
  widget
  text: str
  tip_window
  _show(event=None)
  _hide(event=None)
}
class Recorder <<retained>> {
  frames: list
  stream: InputStream | None
  recording: bool
  sample_rate: int
  warning: str
  start()
  stop()
  _close_stream()
  close()
}
class AudioError <<retained>>
class EntryNotFoundError <<retained>>
class RuntimeError <<external>>
class LookupError <<external>>
class "customtkinter.CTk" as CTk <<external>>
class "Tk widget" as Widget <<external>>
class "customtkinter.CTkToplevel" as TipWindow <<external>>
class "sounddevice.InputStream" as Stream <<external>>
rectangle "data_collector.dataset <<module>>\nload_all(), append_entry(), update_entry()\ndelete_entry(), dataset_lock(), count_by()" as Dataset
rectangle "data_collector.audio_utils <<module>>\nattach_file(), save_recording(), play_audio()" as Audio
App --|> CTk
App "1" *-- "0..1" Recorder : creates if audio is available
Recorder "0..1" --> "0..1" Stream : stream
Tooltip "0..*" --> "1" Widget : widget
Tooltip "0..1" --> "0..1" TipWindow : tip_window
App ..> Tooltip : creates callbacks for controls
App ..> Dataset
App ..> Audio
AudioError --|> RuntimeError
EntryNotFoundError --|> LookupError
Recorder ..> AudioError : raises retryable failures
Audio ..> AudioError
Dataset ..> EntryNotFoundError
App ..> AudioError : reports / retains retry state
App ..> EntryNotFoundError : handles stale selection
note bottom of Recorder
  Actual device sample rate is retained.
  Stop/close failures preserve retryable state.
  Sample arrays are values, not invented domain classes.
  The desktop recorder is not a public browser feature.
end note
legend bottom
  App/Tooltip: data_collector/App.py; Recorder/AudioError: audio_utils.py; EntryNotFoundError: dataset.py.
  App creates the optional Recorder; bound widget callbacks retain Tooltip objects, not an App tooltip collection.
  CSV and local capture workflows are retained operator/desktop compatibility, not the default web product.
endlegend
@enduml
