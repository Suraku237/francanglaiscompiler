@startuml
!include theme.iuml
allowmixing
title Runtime settings, web boundary and shared throttling
hide empty members
package "backend.config" {
  class ServerSettings {
    environment: development | production
    data_dir: Path
    public_url: str
    valid_server()
  }
  class Settings {
    cors_origins: list[str]
  }
}
package "backend.web" {
  class WebBoundaryMiddleware {
    app: ASGIApp
    production: bool
    __init__(app, production=False)
    async __call__(scope, receive, send)
  }
  class PrivateQueryFilter {
    filter(record): bool
  }
}
package "backend.rate_limits" {
  class RateLimitExceeded {
    retry_after: int
    __init__(retry_after)
  }
  rectangle "throttle(db, key, maximum, seconds)\n<<function>>" as Throttle
}
class "pydantic_settings.BaseSettings" as BaseSettings <<external>>
class "logging.Filter" as Filter <<external>>
rectangle "starlette.types.ASGIApp\n<<external callable type alias>>" as ASGI
class Exception <<external>>
class PublicAccessState <<reference>>
class AuthStore <<retained,reference>>
rectangle "main.create_app()\nrequire_auth=None by default\n<<function>>" as Factory
ServerSettings --|> BaseSettings
Settings --|> BaseSettings
PrivateQueryFilter --|> Filter
RateLimitExceeded --|> Exception
WebBoundaryMiddleware "0..*" --> "1" ASGI : app
Factory ..> ServerSettings : public environment / paths / origin
Factory ..> Settings : development CORS origins
Factory ..> WebBoundaryMiddleware : install_web()
Factory ..> PrivateQueryFilter : query-string redaction
PublicAccessState ..> Throttle : public limit database
AuthStore ..> Throttle : retained identity limit database
Throttle ..> RateLimitExceeded : raises with Retry-After
note bottom of ServerSettings
  MBOA_ prefix; .env compatibility retained.
  Public production requires a non-loopback HTTPS origin,
  not mail settings or OAuth credentials.
  AuthSettings extends this class only in explicit legacy mode.
end note
legend bottom
  The ASGI reference is an external callable type alias, not an invented runtime class.
  Settings and ServerSettings are independent BaseSettings subclasses.
  Web boundary applies in all modes; public policy is in public_access.py.
  A microphone Permissions-Policy allowance does not create a public recording feature.
endlegend
@enduml
