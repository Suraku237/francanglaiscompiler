@startuml
!include theme.iuml
allowmixing
title Runtime configuration and actual function boundaries
hide empty members
class "backend.config.Settings" as Settings {
  cors_origins: list[str]
  model_config: env files / extra = ignore
}
class "pydantic_settings.BaseSettings" as BaseSettings <<external>> {
  model_validate(value) {inherited}
  model_dump() {inherited}
}
class "AuthSettings\n(account view)" as AuthSettings <<reference>>
rectangle "main.py <<functions>>\ncreate_app(settings, include_academic=True,\nrequire_auth=True, auth_settings, auth_transport, mailer)\nanalyze(text, entries)" as Factory
rectangle "auth.py <<functions>>\ninstall_auth(), Google identity exchange,\naccount email delivery" as Identity
rectangle "coursework_api.py <<functions>>\ncourse_operation(), analyze_corpus(), parse_text()\ndownload_export(), screenshot routes" as Course
rectangle "imports.py <<functions>>\npreview_file(), _local_preview(), split_segments()\nDOCX/PDF/UTF-8 extraction" as Imports
Settings --|> BaseSettings
Factory ..> Settings : resolves CORS configuration
Factory ..> AuthSettings : resolves identity/deployment policy
Factory ..> Identity : installs account boundary
Factory ..> Course : includes default compiler router
Factory ..> Imports : includes local import router
note bottom of Settings
  There are no generation keys, model names,
  AI timeouts or provider quotas in active settings.
  Existing private GEMINI_* variables are ignored.
end note
legend bottom
  Settings is the only production class introduced in this view.
  Other rectangles are actual function modules, not service classes.
  Auth HTTP still needs httpx for optional Google OAuth; no generative provider client exists.
  Class relationships across views are references; dependencies have no cardinalities.
endlegend
@enduml
