@startuml
!include theme.iuml
title Camfranglais — public processing architecture
top to bottom direction
skinparam wrapWidth 180
actor "Public visitor" as Visitor
[PublicSession / App\npublic React browser] as Browser
package "FastAPI public app — require_auth=None" {
  [main.py / web.py\npublic_access.py\nOrigin + CSRF · allowlist] as Boundary
  together {
    [analyzer.py\nanalyzer_history.py\ntests and statistics] as Analyzer
    [Collection · Dictionary\nSynthetic examples\nread-only source modules] as Reference
    [readings_api.py / audio_api.py\nexisting lookup and playback] as Media
  }
  [PublicWorkspaceStore\nrequest-local adapters] as Store
  [compiler.lexer\ncompiler.parser\nrules · CFG · LL(1)] as Compiler
}
database "Shared SQLite\nexact test snapshots\nand shared resources" as DB
folder "Existing audio files" as Files
artifact "Bundled reference files" as Bundled
Visitor --> Browser
Browser --> Boundary : same-origin HTTPS
Boundary --> Analyzer
Boundary --> Reference
Boundary --> Media
Analyzer --> Compiler
Analyzer --> Store : append/read tests
Reference --> Store : Collection only
Reference --> Bundled
Compiler --> Bundled : vocabulary
Media --> Store : lookup
Media --> Files : checked stream
Store --> DB
note right of Boundary
  IP limits: public-access.sqlite3.
  No account or AuthStore.
  Health bypasses the limiter.
end note
legend bottom
  Components are modules, not invented runtime classes.
  Only tests append; Collection, grammar and audio are read-only.
  Operator backups/legacy APIs are outside this public UI.
  No AI/voice generation, microphone or coursework export UI.
endlegend
@enduml
