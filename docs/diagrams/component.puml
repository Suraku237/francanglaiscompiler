@startuml
!include theme.iuml
title Implemented package dependencies and data boundaries
skinparam componentFontSize 14
package "Browser: frontend/src" {
  component "React function components\n5 workspaces + dialogs/results" as UI
  component "api.ts / useRequest.ts\nHTTP, cancellation, errors" as WebAPI
  component "voice.ts\nopt-in browser speech" as Voice
}
package "Python backend" {
  component "main.py / schemas.py\nFastAPI routes and public DTOs" as Routes
  component "collection.py\nvalidated CRUD functions" as Collection
  component "grounding.py\napproved alignment retrieval" as Grounding
  component "gemini.py / config.py\nprovider client and secret settings" as Gemini
  component "import_api.py / imports.py\nbounded preview and suggestions" as Imports
  component "coursework*.py\nanalysis, profile, images, draft export" as Course
}
package "Local Python libraries" {
  component "compiler/lexer\nregex, reviewed lexicon, reports" as Lexer
  component "compiler/parser\nCFG transforms / LL(1) / traces" as Parser
  component "data_collector/dataset.py\nlock + atomic CSV functions" as Dataset
}
package "Desktop collector" {
  component "App.py\nCustomTkinter UI" as Desktop
  component "audio_utils.py\nRecorder / file / playback" as Audio
}
artifact "dataset.csv\n14 fields; legacy-compatible" as CSV <<file>>
folder "Local audio" as AudioFiles
folder "coursework\nproject.json / screenshots" as Project
cloud "Gemini HTTPS\noptional explicit requests" as Cloud

UI ..> WebAPI
UI ..> Voice
WebAPI ..> Routes : /api
Routes ..> Collection
Routes ..> Grounding
Routes ..> Gemini
Routes ..> Imports : included router
Routes ..> Course : included router
Routes ..> Lexer
Routes ..> Dataset : analysis / retrieval snapshot
Collection ..> Dataset
Grounding ..> Lexer : normalize / tokenize
Imports ..> Gemini : consented media / explicit suggestions
Course ..> Lexer
Course ..> Parser
Course ..> Dataset
Course ..> Project : profile / screenshot operations
Course ..> Gemini : explicit tutoring only
Gemini ..> Cloud
Desktop ..> Dataset
Desktop ..> Audio
Dataset ..> CSV
Audio ..> AudioFiles
note bottom of Parser
  Parser consumes token categories.
  No provider determines acceptance.
end note
note bottom of Grounding
  Modules are functions unless an actual class
  is named in the class inventory.
  Reviewed lookup is not training.
end note
legend bottom
  Dashed arrows are dependencies, not timed calls.
  Browser speech may contact a separate browser provider (deployment view).
  Imports do not automatically write CSV. Export reads saved evidence.
endlegend
@enduml
