@startuml
!include theme.iuml
title Component Dependencies - Baseline and Proposed Analysis
top to bottom direction
package "Implemented desktop collector" {
  component "Presentation\nApp.py" as UI
  component "Dataset functions\ndataset.py" as DS
  component "Audio functions + Recorder\naudio_utils.py" as AS
  artifact "dataset.csv" as DB
  artifact "audio files" as FS
  UI ..> DS : imports / calls
  UI ..> AS : imports / calls
  DS ..> DB : reads / writes
  AS ..> FS : copies / records / plays
}
package "Proposed extension - not verified source" #FFF7ED {
  component "Analysis adapter\n<<proposed>>" as API
  component "Lexer / classifier /\nsentence analysis\n<<proposed>>" as CP
  API ..> CP : requests analysis
  CP ..> DS : proposed read-only evidence access
}

legend bottom left
  Dashed arrows are dependencies, not runtime message order.
  The baseline uses local Python calls, not HTTP.
  The adapter may be local or service-based; no current route is asserted.
endlegend
@enduml
