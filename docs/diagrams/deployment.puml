@startuml
!include theme.iuml
title Deployment - Local Baseline and Optional Future Host
node "Contributor workstation" as workstation <<device>> {
  node "Python + Tcl/Tk" as python <<executionEnvironment>> {
    artifact "data_collector/App.py" as app
    artifact "dataset.py" as dataset
    artifact "audio_utils.py" as audio
  }
  artifact "dataset.csv" as csv
  artifact "audio/*" as audiodir <<file collection>>
  node "OS audio services" as os <<executionEnvironment>>
}
node "Microphone" as mic <<device>>
package "Optional deployment proposal - not implemented" #FFF7ED {
  node "Analysis host" as host <<device>> {
    artifact "Compiler + adapter" as api
    artifact "Approved corpus copy" as snapshot
  }
  node "Client device" as browser <<device>>
  browser -- host : HTTP only if a web adapter is chosen
  api ..> snapshot : read-only local access
}

app ..> dataset : import
app ..> audio : import
dataset ..> csv : local I/O
audio ..> audiodir : local I/O
audio ..> os : record / playback
mic -- workstation : device input
csv ..> snapshot : <<flow>>\nproposed approved corpus transfer
@enduml
