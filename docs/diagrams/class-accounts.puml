@startuml
!include theme.iuml
allowmixing
title Retained accounts — explicit legacy mode only
hide empty members
package "backend.auth — not installed by default" #FFF6E8 {
  class AuthSettings <<retained>> {
    mail_mode: file | smtp
    smtp_host; smtp_port; smtp_username; mail_from
    smtp_password; google_client_secret: SecretStr
    google_client_id: str
    valid_deployment()
  }
  class AuthStore <<retained>> {
    path: Path
    dummy_hash: str
    connection()
    identity(row): UserIdentity {static}
    registered_user_count(): int
    session(raw): UserIdentity | None
    new_session(user_id): str
    issue_token(user_id, purpose): str
    consume_token(raw, purpose, password)
    throttle(key, maximum, seconds)
  }
  class UserIdentity <<retained>> {
    id; email; display_name
    email_verified: bool
    google_linked: bool
  }
  class AuthInput <<retained>> {
    model_config: extra=forbid
  }
  class EmailInput <<retained>> {
    email: EmailStr
  }
  class LoginInput <<retained>> {
    password: str [1..128]
  }
  class RegisterInput <<retained>> {
    display_name: str [1..100]
    password: str [12..128]
  }
  class TokenInput <<retained>> {
    token: str [20..200]
  }
  class ResetInput <<retained>> {
    password: str [12..128]
  }
  class ProfileInput <<retained>> {
    display_name: str [1..100]
  }
  class AuthError <<retained>> {
    status: int
    detail: str
    retry_after: int | None
    __init__(status, detail, retry_after=None)
  }
}
class ServerSettings <<reference>>
class "pydantic.BaseModel" as BaseModel <<external>>
class Exception <<external>>
rectangle "install_auth()\n<<function>>\nexplicit require_auth=True only" as Auth
AuthSettings --|> ServerSettings
UserIdentity --|> BaseModel
AuthInput --|> BaseModel
EmailInput --|> AuthInput
LoginInput --|> EmailInput
RegisterInput --|> LoginInput
TokenInput --|> AuthInput
ResetInput --|> TokenInput
ProfileInput --|> AuthInput
AuthError --|> Exception
AuthStore "0..*" --> "1" AuthSettings : settings
AuthStore ..> UserIdentity : constructs from SQL rows
AuthStore ..> AuthError : raises
Auth ..> AuthStore
Auth ..> AuthInput : validates concrete subclasses
note bottom of AuthSettings
  Environment/data_dir/public_url come from ServerSettings.
  SMTP is required for production only in this explicit
  authenticated mode, not for the default public application.
end note
legend bottom
  Account data and credentials are preserved privately, not exposed as public routes or counters.
  Public access reuses digest/private_directory helpers, not AuthStore or a fabricated visitor account.
  registered_user_count() remains real retained code; the public frontend never displays its result.
endlegend
@enduml
