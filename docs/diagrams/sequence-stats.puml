@startuml
!include theme.iuml
title Preserved desktop statistics from one snapshot
hide footbox
autonumber
actor Maintainer
participant "app : App" as App
participant "dataset\n<<module>>" as Dataset
activate Maintainer
Maintainer -> App : _refresh_stats() or _refresh_views()
activate App
App -> Dataset : load_all() through _load_entries()
activate Dataset
note over Dataset : Locked, validated CSV read.
Dataset --> App : Shared normalized rows or storage exception
deactivate Dataset
alt Read failed
  note over App : Show Dataset unavailable; retain previous bars/total.
else Snapshot available
  note over App : Remove old bars but keep headings.\nTotal = len(snapshot).
  loop Type, topic, language, review status
    App -> App : _render_bar_group(frame, counts, total)
    activate App
    alt Empty counts
      note over App : Display No data yet.
    else Nonempty counts
      note over App : Descending count labels and count / total bars.\nEmpty values use (none).
    end
    App --> App : Group rendered
    deactivate App
  end
end
App --> Maintainer : Consistent distributions or preserved view + error
deactivate App
deactivate Maintainer
legend bottom
  _refresh_views also supplies the same rows to count, recent and Browse views.
  Direct Stats refresh loads once; count_by() is not called by this handler.
  Earlier desktop benchmarks are historical; this diagram makes no current timing claim.
endlegend
@enduml
