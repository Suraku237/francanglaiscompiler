@startuml
!include theme.iuml
allowmixing
title Shared persistence — real store hierarchy and structural protocols
hide empty members
class WorkspaceStore {
  user_id; project: str
  root; path; audio_dir: Path
  _lock: FileLock
  storage_root(data_dir, user_id): Path
  lock(): FileLock
  connection(): Iterator[Connection]
  load_all(): list[dict]
  save_all(entries, action=None)
  load_coursework(): ProjectProfile | None
  save_coursework(profile)
  load_analyzer_test(test_id): RecordedTest | None
  save_analyzer_test(record)
  iter_analyzer_tests(): Iterator[RecordedTest]
  export_document(): dict
  import_document(document, expected_version)
}
class SharedWorkspaceStore {
  owner_name: str
  system: bool
  storage_root(data_dir, user_id): Path
  authorize_write(db, kind, identifier, new=False)
  require_owner(kind, identifier)
  ownership(kind, identifier): Ownership
  load_analyzer_request(request_id): RecordedTest | None
  analyzer_test_identifier(request_id): str
  save_analyzer_request(request_id, record)
  validate_document(document, combined=False): dict {static}
  authorize_import(document)
}
class PublicWorkspaceStore <<reference>>
class DatasetStorage <<protocol>> {
  audio_dir: Path
  lock(): FileLock
  ensure()
  load_all(): list[dict[str, str]]
  save_all(entries)
  append_entry(entry)
  check_audio_capacity(additional)
}
class CourseworkStorage <<protocol>> {
  project: str
  load_coursework(): ProjectProfile | None
  save_coursework(profile)
  list_coursework_screenshots(): list[dict]
  read_coursework_screenshot(image_id): bytes
  save_coursework_screenshot(image_id, name, content)
  delete_coursework_screenshot(image_id)
  load_analyzer_test(test_id): RecordedTest | None
  save_analyzer_test(record)
  iter_analyzer_tests(): Iterator[RecordedTest]
  load_analyzer_request(request_id): RecordedTest | None
  analyzer_test_identifier(request_id): str
  save_analyzer_request(request_id, record)
}
class OwnershipStore <<protocol,reference>>
class ProjectProfile <<reference>>
class RecordedTest <<reference>>
class "filelock.FileLock" as FileLock <<external>>
rectangle "workspaces.use_workspace()\ncurrent_workspace()\n<<ContextVar functions>>" as Context
SharedWorkspaceStore --|> WorkspaceStore
PublicWorkspaceStore --|> SharedWorkspaceStore
WorkspaceStore ..|> DatasetStorage
WorkspaceStore ..|> CourseworkStorage
SharedWorkspaceStore ..|> OwnershipStore
WorkspaceStore "0..*" --> "1" FileLock : _lock
WorkspaceStore ..> ProjectProfile : validates JSON / returns DTO
WorkspaceStore ..> RecordedTest : validates JSON / returns DTO
Context ..> SharedWorkspaceStore : binds selected store
Context ..> DatasetStorage : dataset.use_storage()
Context ..> CourseworkStorage : coursework_store.use_storage()
Context ..> OwnershipStore : use_ownership()
note bottom of SharedWorkspaceStore
  Root: data_dir/shared-workspace (all visitors).
  Separate project mutations raise 409 even in legacy shared mode.
  Public subclass narrows the inherited mutation policy.
  SELECT/INSERT use SQLite rows, not retained DTO object graphs.
end note
legend bottom
  Hollow triangles toward bases; dotted triangles are structural Protocol conformance.
  WorkspaceStore also retains revision/history/screenshot operations for private compatibility.
  use_workspace() resets all request-local bindings on exit; no global file path is reassigned.
  A per-store file lock serializes related shared reads/writes; SQLite transactions protect logical rows.
endlegend
@enduml
