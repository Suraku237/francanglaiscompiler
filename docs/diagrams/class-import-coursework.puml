@startuml
!include theme.iuml
allowmixing
title Local imports, private coursework and constructed practice
hide empty members
package "backend.import_models" {
  class ImportEntry {
    text; entry_type; language
    french_gloss; english_gloss; lexical_category
    category; source_location; contributor; notes
    review_status: unreviewed
    model_config: extra = forbid
  }
  class ImportPreview {
    filename; format
    method: local
    text; segments; warnings
  }
  ImportPreview "0..*" --> "0..100" ImportEntry : drafts
}
package "backend.coursework_models" {
  class ProjectProfile {
    group_members: list[str] [3]
    grammar: str [1..12000 chars]
    manual_transcription_confirmed: bool
    grammar_rationale; discussion
    collection_method; limitations
    distinct_members(members): list[str]
  }
  class GrammarRequest {
    grammar: str [1..12000 chars]
  }
  class ParseRequest {
    text: str [0..4000 chars]
  }
  class ScreenshotRequest {
    name: str [1..120 chars]
    data_url: str [0..2800000 chars]
  }
}
package "backend.coursework_store" {
  class CourseworkStorage <<protocol>> {
    project: str
    load_coursework(): ProjectProfile | None
    save_coursework(profile)
    list_coursework_screenshots(): list[dict]
    read_coursework_screenshot(id): bytes
    save_coursework_screenshot(id, name, content)
    delete_coursework_screenshot(id)
  }
  rectangle "use_storage() / request ContextVar\nload_project(), save_project()\nscreenshot_bytes(), add_screenshot()" as Store
}
package "backend.schemas" {
  class PracticeEntry {
    id; text; french_gloss; english_gloss
    language: francanglais
    topic; notes; source_document; source_line
    constructed: true
  }
  class PracticeResponse {
    total; matched; offset; limit
    sources: list[str]
  }
  PracticeResponse "0..*" --> "0..100" PracticeEntry : entries
}
class "RequestModel\n(request view)" as RequestModel <<reference>>
ProjectProfile --|> RequestModel
GrammarRequest --|> RequestModel
ParseRequest --|> GrammarRequest
ScreenshotRequest --|> RequestModel
Store ..> CourseworkStorage : dispatches bound request
CourseworkStorage ..> ProjectProfile : accepts / returns; not a retained object
Store ..> ScreenshotRequest : validates / normalizes genuine upload
note bottom of CourseworkStorage
  WorkspaceStore structurally implements this protocol.
  Normal requests never read the legacy global profile/screenshots.
  Screenshots are rows/bytes, not an invented Screenshot class.
end note
legend bottom
  Import/practice DTOs directly extend BaseModel; serialization methods are inherited.
  Three member strings may be blank initially; nonblank names must be distinct.
  ImportEntry never accepts an approved status. No suggestion/generation model exists.
  Screenshot limits: 6/project, 2 MiB decoded/normalized, 12 MP; JSON route cap 3 MiB.
  Reference/practice records do not silently become field statements.
endlegend
@enduml
