@startuml
!include theme.iuml
allowmixing
title Retained coursework/import contracts — saved grammar reuse, no public export UI
hide empty members
package "backend.coursework_models" {
  class ProjectProfile {
    group_members: list[str] [3]
    grammar: str [1..12000]
    manual_transcription_confirmed: bool
    grammar_rationale; discussion
    collection_method; limitations
    distinct_members(members): list[str] {class}
  }
  class ParseRequest <<retained>> {
    text: str [0..4000] = ""
  }
  class ScreenshotRequest <<retained>> {
    name: str [1..120]
    data_url: str [0..2800000]
  }
}
package "backend.import_models — retained local extraction" #FFF6E8 {
  class ImportEntry <<retained>> {
    text; entry_type; language
    french_gloss; english_gloss; lexical_category
    category; source_location; contributor; notes
    review_status: unreviewed
  }
  class ImportPreview <<retained>> {
    filename; format; text
    method: local
    segments; warnings: list[str]
  }
}
class RequestModel <<reference>>
class GrammarRequest <<reference>>
class CourseworkStorage <<protocol,reference>>
class "pydantic.BaseModel" as BaseModel <<external>>
rectangle "coursework_store.load_project()\n<<function>>" as Load
ProjectProfile --|> RequestModel
ParseRequest --|> GrammarRequest
ScreenshotRequest --|> RequestModel
ImportEntry --|> BaseModel
ImportPreview --|> BaseModel
ImportPreview "0..*" --> "0..100" ImportEntry : drafts
CourseworkStorage ..> ProjectProfile : load/save contract
Load ..> CourseworkStorage : request-local storage
Load ..> ProjectProfile : returns saved profile or starter
note bottom of ProjectProfile
  The public analyzer reads only the saved grammar through
  this retained profile model; there is no profile-editing UI.
  Three nonblank member strings must be distinct if supplied.
  manual_transcription_confirmed is stored data, not a
  verified certification of consent, location or collection date.
end note
legend bottom
  ProjectProfile still participates in active grammar loading; the other authored classes here are retained compatibility.
  GrammarRequest is a shared public analyzer input base, detailed in class-api-requests.
  Import preview, screenshots, coursework editing and generated report/presentation routes are not mounted publicly.
  Profile/screenshot/archive preservation does not expose legacy data through the default public application.
endlegend
@enduml
