@startuml
!include theme.iuml
title Collection, Dictionary and Synthetic examples — separate data models
hide empty members
class "pydantic.BaseModel" as BaseModel <<external>>
class DatasetEntry {
  id; text; entry_type
  french_gloss; english_gloss
  category; source_location; contributor; notes
  audio_filename; timestamp
  language; review_status; lexical_category
}
class OwnedDatasetEntry
class DatasetResponse {
  total: int
  by_category; by_type; by_review_status: dict[str, int]
}
class DictionaryEntry {
  id; text; aliases
  language; part_of_speech; english_gloss
  origin; topic; source_document
  source_line: int >= 1
}
class DictionaryResponse {
  total; matched; offset; limit: int
  sources: list[str]
}
class PracticeEntry {
  id; text; language
  french_gloss; english_gloss; topic; notes
  source_document; source_line
  constructed: true
}
class PracticeResponse {
  total; matched; offset; limit: int
  sources: list[str]
}
class Ownership <<reference>>
class CollectionError {
  status_code: int
  detail: str
  __init__(status_code, detail)
}
class Exception <<external>>
DatasetEntry --|> BaseModel
OwnedDatasetEntry --|> DatasetEntry
DatasetResponse --|> BaseModel
DictionaryEntry --|> BaseModel
DictionaryResponse --|> BaseModel
PracticeEntry --|> BaseModel
PracticeResponse --|> BaseModel
CollectionError --|> Exception
OwnedDatasetEntry "0..*" --> "1" Ownership : ownership
DatasetResponse "0..*" --> "0..*" DatasetEntry : entries\nmay contain OwnedDatasetEntry
DictionaryResponse "0..*" --> "0..100" DictionaryEntry : entries
PracticeResponse "0..*" --> "0..100" PracticeEntry : entries
note bottom of DatasetResponse
  Matching entries are returned newest first.
  Counts summarize the whole Collection, not only matches.
  Public entries preserve source metadata but redact the
  ownership object; contributor text is not an account ID.
end note
legend bottom
  DTO source: backend/schemas.py; CollectionError: backend/collection.py.
  No association links a dictionary/practice entry to a Collection entry: selecting text does not save it.
  Public views are read-only. review_status records a review; it does not certify human provenance.
  Dictionary/practice serialization is inherited from BaseModel, not invented business methods.
endlegend
@enduml
